# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY updater/go.mod ./
COPY updater/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /netkeep-updater .

FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS cosign
RUN CGO_ENABLED=0 GOBIN=/out go install github.com/sigstore/cosign/v3/cmd/cosign@v3.1.4

FROM docker:29.9.3-cli@sha256:2357639ad1ea7d0194134bf3292622fd4e562483966ed674e5d7c945b5f3b28d
RUN apk upgrade --no-cache \
    && rm -f /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=build /netkeep-updater /usr/local/bin/netkeep-updater
COPY --from=cosign /out/cosign /usr/local/bin/cosign
LABEL org.opencontainers.image.title="NetKeep Updater" \
    org.opencontainers.image.authors="Lucas Quaresma <keep@lrq.lat>" \
    org.opencontainers.image.source="https://github.com/lrqnet/NetKeep" \
    org.opencontainers.image.licenses="AGPL-3.0-only"
ENTRYPOINT ["/usr/local/bin/netkeep-updater"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 CMD ["/usr/local/bin/netkeep-updater", "healthcheck"]
