# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS tools-build
WORKDIR /src/reporter
COPY oxidized-reporter/go.mod oxidized-reporter/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /netkeep-oxidized-reporter .
WORKDIR /src/controller
COPY sandbox-controller/go.mod sandbox-controller/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /netkeep-sandbox-controller .

FROM oxidized/oxidized:0.37.0@sha256:07d8d7d669bb210b1100d121bbe214a3d64d621b1768f8f2179a1508a772541e AS runtime

USER root

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /etc/service \
    && ln -s /home/oxidized/.config/oxidized/.ssh /home/oxidized/.ssh \
    && chown -h 30000:30000 /home/oxidized/.ssh

# FTD requires rubyzip. Verify the immutable gem before installing it locally.
RUN cd /tmp \
    && gem fetch rubyzip --version 3.7.0 \
    && echo '65c19294da75297a939006f3516deacc33185fbd721ff1954f7a231db6d3e121  rubyzip-3.7.0.gem' | sha256sum -c - \
    && gem install --local rubyzip-3.7.0.gem --no-document --ignore-dependencies \
    && rm rubyzip-3.7.0.gem

COPY docker/oxidized/upstream /tmp/oxidized-backports
COPY docker/oxidized/upstream.json docker/oxidized/LICENSE /usr/local/share/netkeep-oxidized/
RUN --network=none ruby -rjson -rdigest -rfileutils -e '\
    root = Gem::Specification.find_by_name("oxidized").full_gem_path; \
    manifest = JSON.parse(File.read("/usr/local/share/netkeep-oxidized/upstream.json")); \
    manifest.fetch("files").each do |path, sha|; \
      source = "/tmp/oxidized-backports/#{path}"; \
      abort "Invalid backport checksum: #{path}" unless Digest::SHA256.file(source).hexdigest == sha; \
      FileUtils.cp(source, "#{root}/#{path}"); \
    end; FileUtils.rm_rf("/tmp/oxidized-backports")'

COPY --from=tools-build /netkeep-oxidized-reporter /usr/local/bin/netkeep-oxidized-reporter
COPY --from=tools-build /netkeep-sandbox-controller /usr/local/bin/netkeep-sandbox-controller

LABEL org.opencontainers.image.title="NetKeep Oxidized" \
    org.opencontainers.image.authors="Lucas Quaresma <keep@lrq.lat>" \
    org.opencontainers.image.source="https://github.com/lrqnet/NetKeep" \
    org.opencontainers.image.licenses="AGPL-3.0-only"

USER 30000:30000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["oxidized"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["ruby", "-rnet/http", "-e", "u=URI('http://localhost:8888/nodes.json');r=Net::HTTP::Get.new(u);r['Host']='oxidized';exit(Net::HTTP.start(u.host,u.port){|h|h.request(r)}.is_a?(Net::HTTPSuccess) ? 0 : 1)"]

# Development dependencies and fixtures never enter the published runtime.
FROM runtime AS model-tests
USER root
RUN cd /tmp \
    && gem fetch mocha --version 3.1.0 \
    && echo '75f42d69ebfb1f10b32489dff8f8431d37a418120ecdfc07afe3bc183d4e1d56  mocha-3.1.0.gem' | sha256sum -c - \
    && gem install --local mocha-3.1.0.gem --no-document --ignore-dependencies \
    && rm mocha-3.1.0.gem
COPY docker/oxidized/tests /tests
USER 30000:30000
ENTRYPOINT ["ruby"]
CMD ["/tests/run.rb"]

FROM runtime AS final
