# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.24.5-alpine@sha256:daae04ebad0c21149979cd8e9db38f565ecefd8547cf4a591240dc1972cf1399 AS build
WORKDIR /src
COPY updater/go.mod ./
COPY updater/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /netkeep-updater .

FROM ghcr.io/sigstore/cosign/cosign:v3.0.6@sha256:de9c65609e6bde17e6b48de485ee788407c9502fa08b8f4459f595b21f56cd00 AS cosign

FROM docker:28.3.3-cli@sha256:0135662b510037ea581d99c2e5929c5e01185139c0b86986a418bd4da0b98a44
COPY --from=build /netkeep-updater /usr/local/bin/netkeep-updater
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
LABEL org.opencontainers.image.title="NetKeep Updater" \
    org.opencontainers.image.authors="Lucas Quaresma <keep@lrq.lat>" \
    org.opencontainers.image.source="https://github.com/lrqnet/NetKeep" \
    org.opencontainers.image.licenses="AGPL-3.0-only"
ENTRYPOINT ["/usr/local/bin/netkeep-updater"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 CMD ["/usr/local/bin/netkeep-updater", "healthcheck"]
