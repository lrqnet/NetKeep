{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "author": {
        "name": "Lucas Quaresma",
        "email": "keep@lrq.lat"
    },
    "type": "module",
    "scripts": {
        "assets:favicons": "node scripts/generate-favicons.mjs",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ \"*.{json,md,yaml,yml}\" \"docs/**/*.md\" \".github/**/*.{md,yaml,yml}\"",
        "format:check": "prettier --check resources/ \"*.{json,md,yaml,yml}\" \"docs/**/*.md\" \".github/**/*.{md,yaml,yml}\"",
        "lint": "eslint . --fix",
        "lint:check": "node scripts/check-eslint-config.mjs && eslint . --max-warnings 0",
        "test:e2e": "playwright test",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
        "test:e2e:report": "playwright show-report",
        "translations:check": "tsx scripts/check-translations.ts",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@babel/core": "^8.1.0",
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@playwright/test": "1.65.0",
        "@rolldown/plugin-babel": "^0.3.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tsx": "^4.23.15",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vite": "^3.11.0",
        "@laravel/passkeys": "^0.4.1",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.7",
        "globals": "^17.14.0",
        "i18next": "^27.0.1",
        "input-otp": "^1.5.0",
        "laravel-vite-plugin": "^3.2.1",
        "lucide-react": "^1.70.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.6"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.68.0",
        "@rollup/rollup-win32-x64-msvc": "4.68.0",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
        "@tailwindcss/oxide-win32-x64-msvc": "4.3.5",
        "lightningcss-linux-x64-gnu": "1.33.0",
        "lightningcss-win32-x64-msvc": "1.33.0"
    },
    "overrides": {
        "minimatch@>=9 <11.0.1": "11.0.4"
    }
}
