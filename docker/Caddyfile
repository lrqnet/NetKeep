{
	frankenphp
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1
	}
	import /config/netkeep-global.caddy
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/caddy/ask
	}
}

(netkeep_app) {
	root * /app/public
	encode zstd br gzip

	@externalOxidized {
		path /internal/oxidized/*
		not host app
	}
	respond @externalOxidized 404

	@externalCaddy {
		path /internal/caddy/*
		not remote_ip 127.0.0.1 ::1
	}
	respond @externalCaddy 404

	php_server

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

:8080 {
	import netkeep_app
}

https://:8443 {
	tls {
		on_demand
	}
	import netkeep_app
}

import /config/netkeep-canonical.caddy
