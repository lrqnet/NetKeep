{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "author": {
        "name": "Lucas Quaresma",
        "email": "keep@lrq.lat"
    },
    "type": "module",
    "scripts": {
        "assets:favicons": "node scripts/generate-favicons.mjs",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ \"*.{json,md,yaml,yml}\" \"docs/**/*.md\" \".github/**/*.{md,yaml,yml}\"",
        "format:check": "prettier --check resources/ \"*.{json,md,yaml,yml}\" \"docs/**/*.md\" \".github/**/*.{md,yaml,yml}\"",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:e2e": "playwright test",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
        "test:e2e:report": "playwright show-report",
        "translations:check": "tsx scripts/check-translations.ts",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.12.1",
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tsx": "^4.23.1",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.4",
        "globals": "^17.8.0",
        "i18next": "^26.3.6",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.11",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@rollup/rollup-win32-x64-msvc": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
